<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Generation par IA : les tests ne dependent ni de la cle ni du pipeline du fichier .env local. -->
        <env name="OPENROUTER_API_KEY" value=""/>
        <env name="BLOG_AI_PIPELINE" value="simulated"/>
        <!-- Audit du 23/11 : les tests n'heritent d'aucune cle du .env local. Un test qui a besoin d'une cle la pose
             lui-meme. Le journal se coupe dans tests/TestCase.php : ici, la valeur « null » serait lue comme une
             absence de canal, et Laravel ecrirait dans son journal de secours. -->
        <env name="RESEND_API_KEY" value=""/>
        <env name="PIXABAY_API_KEY" value=""/>
        <env name="SIGNWELL_API_KEY" value=""/>
        <env name="SIGNWELL_API_APPLICATION_ID" value=""/>
        <env name="STRIPE_SECRET_KEY" value=""/>
        <env name="STRIPE_WEBHOOK_SECRET" value=""/>
        <env name="ANALYTICS_GEOIP_LICENSE_KEY" value=""/>
        <env name="ANALYTICS_GSC_CLIENT_SECRET" value=""/>
    </php>
</phpunit>
